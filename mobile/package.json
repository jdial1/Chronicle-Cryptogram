  "dependencies": {
    "@react-native-firebase/app": "^26.3.0",
    "expo": "~57.0.15",
    "expo-build-properties": "^57.0.17",
    "expo-constants": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-google-signin": "^2.0.0",
