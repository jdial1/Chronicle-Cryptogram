<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics for the typewriter keys. Nothing else is needed offline. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Chronicle Cryptogram"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronicle">

        <!--
          enableOnBackInvokedCallback is predictive back, read only on API 33
          and above. Older devices ignore the attribute and get the ordinary
          back behaviour, so tools:targetApi tells lint that is deliberate
          rather than an oversight at minSdk 26.
        -->
        <activity
            android:name=".MainActivity"
            tools:targetApi="tiramisu"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Chronicle.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands the shared clipping to the receiving app as a content:// URI.
          A file:// URI has thrown since API 24, and the other app has no
          permission to this cache directory in any case.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clippings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
