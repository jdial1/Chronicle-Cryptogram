<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose paints everything; this exists so the window background matches the
      paper before the first frame instead of flashing the platform default.
      Colours are duplicated here because a resource cannot read a Compose token.
    -->
    <style name="Theme.Chronicle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      The launch theme. Android draws this itself before the process has a
      window, so it is the only way to control the very first frame; without it
      the app opens on a blank system window. postSplashScreenTheme hands over
      to the real theme once Compose is ready.
    -->
    <style name="Theme.Chronicle.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Chronicle</item>
    </style>
</resources>
