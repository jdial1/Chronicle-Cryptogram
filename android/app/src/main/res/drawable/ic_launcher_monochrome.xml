<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer, for launchers that tint every icon to the wallpaper
  palette (Android 13+). It must be a single-colour silhouette, so the card's
  two-tone C cannot be used: this is the rule and the tab alone, which is what
  reads at 48dp anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer rule of the card, drawn as a stroked box inside the safe zone. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3"
        android:pathData="M25,25 L83,25 L83,83 L25,83 Z" />
    <!-- Inner rule. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="M30,30 L78,30 L78,78 L30,78 Z" />
    <!-- The masthead tab. -->
    <path
        android:fillColor="#000000"
        android:pathData="M46,22 L62,22 L62,28 L46,28 Z" />
    <!-- A serif C, as a stroked arc with terminals. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="9"
        android:strokeLineCap="butt"
        android:pathData="M65,44 A18,20 0 1,0 65,64" />
</vector>
