<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon. Background and foreground are separate layers because the
  launcher masks them to whatever shape the device uses, and animates them apart
  on some. The bordered card sits inside the 66dp safe zone of the foreground,
  so no mask can crop the rule off it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_paper" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
